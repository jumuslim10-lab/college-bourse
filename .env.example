# Скопируй этот файл в .env и заполни. В git .env не попадает.
# Токен получаешь у @BotFather в Telegram.
BOT_TOKEN=

# Твои Telegram ID (можно несколько через запятую). Узнать: @userinfobot
ADMIN_IDS=

# Где хранятся данные: sqlite (файл рядом с ботом, работает без интернета) или postgres (Supabase).
# SQLite остаётся аварийным режимом: если облако недоступно, переключаешься одной строкой.
DB_BACKEND=sqlite

# Строка подключения к Postgres. Нужна только при DB_BACKEND=postgres.
# Supabase: Project Settings → Database → Connection string → URI
# Для новых проектов бери вариант Session pooler — он работает по IPv4.
DATABASE_URL=

# Путь к файлу SQLite (по умолчанию data/bot.db в папке проекта)
DB_PATH=

# Час (локальное время), в который отправляется утренний дайджест
DIGEST_HOUR=8

# true — показывать все категории, пока биржа раскручивается.
# false — категория видна только если в ней >= 5 активных объявлений.
BOOTSTRAP_CATEGORIES=true
